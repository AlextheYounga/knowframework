// English lexicon for the geometry module.
// Encoding: RON. Schema: LexicalModule (know-lexicon).
//
// Bindings may reference concepts from any module: the lexical layer maps
// words to canonical IDs, it does not own the concepts. "Diamond" preserves
// two genuinely different meanings rather than allowing a shared spelling to
// erase their distinction.

LexicalModule(
    language: "en",
    forms: [
        LexicalForm(
            text: "square",
            language: "en",
            part_of_speech: Some(Noun),
            bindings: [
                LexicalBinding(
                    concept: "geometry::square",
                    context_hints: [
                        "geometry::rectangle",
                        "geometry::polygon",
                        "geometry::figure",
                    ],
                    usage_examples: ["a square has four equal sides"],
                    provenance: (
                        source: HumanAuthored(author: Some("Alex Younger")),
                        timestamp: Some("2026-07-23T18:50:50-05:00"),
                        notes: Some("Records the ordinary geometric noun sense of square."),
                    ),
                ),
            ],
        ),
        LexicalForm(
            text: "diamond",
            language: "en",
            part_of_speech: Some(Noun),
            bindings: [
                LexicalBinding(
                    concept: "geometry::rhombus",
                    context_hints: [
                        "geometry::quadrilateral",
                        "geometry::polygon",
                    ],
                    usage_examples: ["a diamond drawn on the page"],
                    provenance: (
                        source: HumanAuthored(author: Some("Alex Younger")),
                        timestamp: Some("2026-07-23T18:50:50-05:00"),
                        notes: Some("Records diamond as a contextual name for a drawn rhombus."),
                    ),
                ),
                LexicalBinding(
                    concept: "mineralogy::diamond",
                    context_hints: [
                        "mineralogy::gemstone",
                        "mineralogy::carbon",
                    ],
                    usage_examples: ["a diamond set in a ring"],
                    provenance: (
                        source: HumanAuthored(author: Some("Alex Younger")),
                        timestamp: Some("2026-07-23T18:50:50-05:00"),
                        notes: Some("Preserves the distinct mineral sense rather than merging it with the geometric sense."),
                    ),
                ),
            ],
        ),
    ],
)
